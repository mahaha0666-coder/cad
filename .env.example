# Copy this file to .env and fill the value locally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOOL_ROUNDS=4

# Vision model is used by scripts/run_vision.py, not every chat request.
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_VISION_DETAIL=original
DEEPSEEK_VISION_THINKING=disabled
DEEPSEEK_VISION_TIMEOUT_SECONDS=60
DEEPSEEK_VISION_MAX_OUTPUT_TOKENS=4096

# Optional PostgreSQL override; local default is postgresql:///cad_kb.
# DATABASE_URL=postgresql:///cad_kb
    
# Semantic search: standalone Qdrant Server + CPU FastEmbed model.
# Local-mode fallback only; ignored while QDRANT_URL is set.
QDRANT_PATH=.data/qdrant
QDRANT_COLLECTION=cad_semantic_chunks
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true
NO_PROXY=127.0.0.1,localhost

# Upload pipeline. Vision is enabled by default when the API key is present.
UPLOAD_ROOT=data/uploads
UPLOAD_MAX_DWG_BYTES=104857600
UPLOAD_MAX_PNG_BYTES=41943040
UPLOAD_RUN_VISION=true
DWGREAD_PATH=libredwg-build/dwgread

# Local frontend dev server origins.
